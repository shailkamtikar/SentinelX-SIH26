# Copy this file to .env for local development (gitignored, never committed).
# Placeholders only — never commit real values.
#
# The backend runs fine with everything below unset: persistence, raw .eml
# storage and the AI explanation are all optional, best-effort stages that
# fail safe without changing the /analyze-email response.

# Supabase project URL and server-only secret key, used for best-effort
# persistence of analysis results (app/services/analysis_store.py) and for
# uploading the original .eml to the PRIVATE `eml-evidence` Storage bucket
# (app/services/evidence_storage.py). The secret key is server-only and must
# never reach browser code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only key for the optional Gemini explanation stage
# (app/services/gemini_explainer.py). When unset, analysis still succeeds and
# the deterministic assessment remains authoritative — no AI text is invented.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL=
