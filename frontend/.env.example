# Base URL of the SentinelX FastAPI backend.
# Copy this file to .env.local for local development (gitignored, never committed).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project URL and anon (public) key, used ONLY for browser-side
# email/password authentication (Milestone 1). Both values are safe to
# expose to the browser — never put the service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
